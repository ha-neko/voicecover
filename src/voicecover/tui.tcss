Screen {
    background: #0b1018;
    align: center middle;
}

#form {
    width: 86;
    max-width: 95%;
    height: 1fr;
    margin: 1 0;
    padding: 1 2;
    border: round #6787a8;
    background: #111925;
}

.field-label {
    margin-top: 1;
    color: #a9bed3;
    text-style: bold;
}

.row {
    width: 100%;
    height: 6;
    layout: horizontal;
}

.field {
    width: 1fr;
    height: 6;
    margin-right: 1;
    overflow: hidden;
}

Input, Select {
    width: 100%;
}

#switches {
    height: 3;
    margin-top: 1;
}

#switches Checkbox {
    width: 1fr;
}

#actions {
    height: 4;
    align: left middle;
}

#start {
    width: 28;
}

#loading {
    width: 8;
    height: 3;
    margin-left: 2;
}

#log {
    height: 10;
    min-height: 6;
    border: round #35495e;
    background: #090e15;
    padding: 0 1;
}
